#!/bin/sh
# worktrunk action: open the `wt list` popup for the focused pane's directory.
# Output is wt's own status table; this script does not parse it.
set -u
herdr_bin="${HERDR_BIN_PATH:-herdr}"
ctx="${HERDR_PLUGIN_CONTEXT_JSON:-{}}"
cwd="$(HERDR_PLUGIN_CONTEXT_JSON="$ctx" python3 -c 'import json,os; d=json.loads(os.environ["HERDR_PLUGIN_CONTEXT_JSON"]); print(d.get("focused_pane_cwd") or d.get("workspace_cwd") or "")' 2>/dev/null || true)"
if [ -z "$cwd" ]; then
  cwd="$(printf '%s' "$ctx" | sed -n 's/.*"focused_pane_cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
fi
if [ -n "$cwd" ]; then
  exec "$herdr_bin" plugin pane open --plugin worktrunk --entrypoint list --cwd "$cwd"
else
  exec "$herdr_bin" plugin pane open --plugin worktrunk --entrypoint list
fi
